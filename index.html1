<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Store Products</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Header / Navbar -->
    <header class="navbar">
        <h1 class="logo">a</h1>
        <div class="cart">
            <span class="cart-icon">🛒</span>
            <span id="cart-count">0</span>
        </div>
    </header>

    <!-- Main Container -->
    <main class="store-container">
        
        <!-- Card 1 (Text only) -->
        <div class="card">
            <p class="card-text">Lorem ipsum dolor sit amet consectetur adipisicing elit. Voluptatum explicabo voluptatibus! Consequatur?</p>
            <div class="btn-group">
                <button class="btn minus">-</button>
                <button class="btn plus">+</button>
            </div>
        </div>

        <!-- Card 2 (Text only) -->
        <div class="card">
            <p class="card-text">Lorem ipsum dolor sit amet consectetur adipisicing elit. Voluptatum explicabo voluptatibus! Consequatur?</p>
            <div class="btn-group">
                <button class="btn minus">-</button>
                <button class="btn plus">+</button>
            </div>
        </div>

        <!-- Card 3 (Text only) -->
        <div class="card">
            <p class="card-text">Lorem ipsum dolor sit amet consectetur adipisicing elit. Voluptatum explicabo voluptatibus! Consequatur?</p>
            <div class="btn-group">
                <button class="btn minus">-</button>
                <button class="btn plus">+</button>
            </div>
        </div>

        <!-- Card 4 (With Image) -->
        <div class="card">
            <div class="img-box">
                <img src="blender.png" alt="Blender">
            </div>
            <p class="card-text">Lorem ipsum dolor sit amet consectetur adipisicing elit. Voluptatum explicabo voluptatibus! Consequatur?</p>
            <div class="btn-group">
                <button class="btn minus">-</button>
                <button class="btn plus">+</button>
            </div>
        </div>

        <!-- Card 5 (With Image) -->
        <div class="card">
            <div class="img-box">
                <img src="blender.png" alt="Blender">
            </div>
            <p class="card-text">Lorem ipsum dolor sit amet consectetur adipisicing elit. Voluptatum explicabo voluptatibus! Consequatur?</p>
            <div class="btn-group">
                <button class="btn minus">-</button>
                <button class="btn plus">+</button>
            </div>
        </div>

        <!-- Card 6 (With Image) -->
        <div class="card">
            <div class="img-box">
                <img src="blender.png" alt="Blender">
            </div>
            <p class="card-text">Lorem ipsum dolor sit amet consectetur adipisicing elit. Voluptatum explicabo voluptatibus! Consequatur?</p>
            <div class="btn-group">
                <button class="btn minus">-</button>
                <button class="btn plus">+</button>
            </div>
        </div>

    </main>

    <script src="script.js"></script>
</body>
</html>